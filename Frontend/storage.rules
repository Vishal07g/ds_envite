rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read access for all invitation media (images, videos, music, files)
    // Write access is open for the drive_storage path used by the app
    match /drive_storage/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    // Default: deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

