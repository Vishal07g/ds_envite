{
  "rewrites": [
    {
      "source": "/api/og-image",
      "destination": "/api/og-image"
    },
    {
      "source": "/invite/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|whatsapp|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|applebot|googlebot|google-inspectiontool|pinterest|skypeuripreview|viber|vkshare|embedly).*"
        }
      ],
      "destination": "/api/invite?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
