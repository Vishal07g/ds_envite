# Firebase Configuration (Get from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Drive Cloud Storage Integration
VITE_GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/your_root_folder_id?usp=sharing
VITE_GOOGLE_DRIVE_ROOT_FOLDER_ID=your_root_folder_id
VITE_GOOGLE_DRIVE_WEBHOOK_URL=
VITE_GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here
VITE_GOOGLE_DRIVE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
